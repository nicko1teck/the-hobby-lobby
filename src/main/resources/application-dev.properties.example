# Local development settings.
#
# Copy this file to  application-dev.properties  (same folder), fill in real values,
# and run the app with the "dev" profile:  --spring.profiles.active=dev
# application-dev.properties is git-ignored, so your real values are never committed.
#
# Alternative: skip this file and set the same values as environment variables
# (see README.md) in your IDE's run configuration.

spring.datasource.url=jdbc:mysql://localhost:3306/springboottutorial?useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=your_local_db_user
spring.datasource.password=your_local_db_password

cloudinary.cloud_name=your_cloud_name
cloudinary.api_key=your_api_key
cloudinary.api_secret=your_api_secret

spring.mail.username: your_account@gmail.com
spring.mail.password: your_gmail_app_password

site.url=http://localhost:8080/the-hobby-lobby
